{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      ["feat", "fix", "enh", "chore", "docs", "style", "refactor", "test", "perf", "ci", "WIP"]
    ],
    "type-case": [0, "always", "lower-case"],
    "subject-case": [0],
    "header-max-length": [2, "always", 300]
  }
}

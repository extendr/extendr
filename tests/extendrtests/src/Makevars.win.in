TARGET = $(subst 64,x86_64,$(subst 32,i686,$(WIN)))-pc-windows-gnu

TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/$(TARGET)/@LIBDIR@
STATLIB = $(LIBDIR)/libextendrtests.a
PKG_LIBS = -L$(LIBDIR) -lextendrtests -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll
DOCUMENT = rust/document.exe
DOCUMENT_SRC = rust/document.c

all: $(SHLIB) rust_clean

.PHONY: $(STATLIB)

$(SHLIB): $(STATLIB)

CARGOTMP = $(CURDIR)/.cargo
VENDOR_DIR = vendor

$(STATLIB):
	mkdir -p "$(TARGET_DIR)/libgcc_mock"
	touch "$(TARGET_DIR)/libgcc_mock/libgcc_eh.a"

  # If a vendor directory exists, it is used for offline compilation. Otherwise if
  # vendor.tar.xz exists, it is unzipped and used for offline compilation.
	if [ -d ./vendor ]; then \
		echo "=== Using offline vendor directory ==="; \
		mkdir -p "$(CARGOTMP)" && \
		cp rust/vendor-config.toml "$(CARGOTMP)/config.toml"; \
	elif [ -f ./rust/vendor.tar.xz ]; then \
		echo "=== Using offline vendor tarball ==="; \
		tar xf rust/vendor.tar.xz && \
		mkdir -p "$(CARGOTMP)" && \
		cp rust/vendor-config.toml "$(CARGOTMP)/config.toml"; \
	fi

	# Build the project using Cargo with additional flags
	export CARGO_HOME="$(CARGOTMP)" && \
	export LIBRARY_PATH="$(LIBRARY_PATH);$(CURDIR)/$(TARGET_DIR)/libgcc_mock" && \
	RUSTFLAGS="$(RUSTFLAGS) --print=native-static-libs" cargo build @CRAN_FLAGS@ --target=$(TARGET) --lib @PROFILE@ --manifest-path=rust/Cargo.toml --target-dir="$(TARGET_DIR)"

	# Generate wrappers using a linked C executable. The helper only runs the
	# R-free wrapper generator, but the windows-gnu staticlib emits a single
	# `.text` section per codegen unit, so `--gc-sections` cannot drop the
	# R-calling wrapper code pulled in alongside it (unlike macOS/Linux, which
	# strip it). Rather than link `-lR`, resolve the never-called R symbols with
	# trap stubs: trial-link to discover the undefined symbols, emit a stub for
	# each, then link for real. A genuine live call to one would abort loudly,
	# and any non-R link error still fails the build.
	$(CC) -o $(DOCUMENT) $(DOCUMENT_SRC) $(PKG_LIBS) 2> document-link.log || true
	sed -n "s/.*undefined reference to .\([A-Za-z0-9_]*\).$$/\1/p" document-link.log \
		| sort -u | awk '{print "void " $$0 "(void){__builtin_trap();}"}' > document-rstubs.c
	$(CC) -o $(DOCUMENT) $(DOCUMENT_SRC) document-rstubs.c $(PKG_LIBS)
	./$(DOCUMENT) $(R_PACKAGE_NAME) ../R/extendr-wrappers.R
	rm -f $(DOCUMENT) document-rstubs.c document-link.log

	# Always clean up CARGOTMP
	rm -Rf "$(CARGOTMP)";

rust_clean: $(SHLIB)
	rm -Rf "$(CARGOTMP)" "$(VENDOR_DIR)" @CLEAN_TARGET@

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) "$(TARGET_DIR)" "$(VENDOR_DIR)" $(DOCUMENT)
